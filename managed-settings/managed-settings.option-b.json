{
  "rules": [
    {
      "capability": "signin_method",
      "match": [
        "*"
      ],
      "exclude": [
        "external_idp"
      ],
      "effect": "deny"
    },
    {
      "capability": "shell",
      "match": [
        "git push *--force*",
        "git push -f*",
        "git push * -f*",
        "git push *+*",
        "git push * :*",
        "git push *--mirror*",
        "git push *--delete*",
        "git push -d*",
        "git push * -d *",
        "git push *--prune*",
        "git reset *--hard*",
        "git clean -*f*",
        "git branch *-D*",
        "git filter-branch*",
        "git filter-repo*",
        "git update-ref -d*",
        "git reflog expire*"
      ],
      "effect": "deny"
    },
    {
      "capability": "shell",
      "match": [
        "git commit *--no-verify*",
        "git commit -n*",
        "git push *--no-verify*",
        "git config *core.hooksPath*"
      ],
      "effect": "deny"
    },
    {
      "capability": "shell",
      "match": [
        "rm -rf /*",
        "rm -rf ~*",
        "rm -rf $HOME*",
        "rm -rf ..*",
        "rm -rf .git*",
        "rm -rf ./.git*",
        "rm -fr /*",
        "rm -fr ~*",
        "rm -fr $HOME*",
        "rm -fr ..*",
        "rm -fr .git*",
        "rm -fr ./.git*",
        "mkfs*",
        "dd *of=/dev/*"
      ],
      "effect": "deny"
    },
    {
      "capability": "shell",
      "match": [
        "sudo *",
        "su *",
        "doas *",
        "chown *",
        "chmod 777 *",
        "chmod * 777 *"
      ],
      "effect": "deny"
    },
    {
      "capability": "shell",
      "match": [
        "bash -c *",
        "bash -lc *",
        "sh -c *",
        "zsh -c *",
        "/bin/bash -c *",
        "/bin/sh -c *",
        "/bin/zsh -c *",
